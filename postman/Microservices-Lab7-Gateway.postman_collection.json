                  "const o = pm.response.json();",
                  "pm.test('User data came from User Service', () => pm.expect(o.userName).to.eql('Ada Lovelace'));",
                  "pm.test('Product data came from Product Service', () => { pm.expect(o.productName).to.eql('Data Structures Textbook'); pm.expect(o.unitPrice).to.eql(40); });",
