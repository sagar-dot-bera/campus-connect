{
  "info": {
    "name": "Microservices – Lab 7 (API Gateway)",
    "description": "Every request goes through the API Gateway: {{gatewayUrl}}.\n\nLocal: http://localhost:8080 (default). Cloud: select the 'Lab7 - Render' environment, or set the collection variable gatewayUrl to your public Render URL.\n\nFolders 00-03 run in the Collection Runner. Folder 04 needs a manual stop/start of user-service.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gatewayUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "tempUserId",
      "value": ""
    },
    {
      "key": "invalidId",
      "value": "000000000000000000000000"
    }
  ],
  "item": [
    {
      "name": "00 API Gateway",
      "item": [
        {
          "name": "Gateway health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/health",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Answered by the gateway itself', () => pm.expect(pm.response.json().service).to.eql('api-gateway'));"
                ]
              }
            }
          ]
        },
        {
          "name": "All services health (via registry)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/health/services",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "health",
                "services"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('All three services UP', () => pm.response.json().services.forEach(s => pm.expect(s.status, s.service).to.eql('UP')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown route (404 from gateway)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/does-not-exist",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "does-not-exist"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('Gateway error body', () => pm.expect(pm.response.json().error).to.include('No route'));"
                ]
              }
            }
          ]
        }
      ]
    },
