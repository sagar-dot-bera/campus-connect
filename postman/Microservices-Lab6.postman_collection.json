  },
  "variable": [
    {
      "key": "userBaseUrl",
      "value": "http://localhost:3001"
    },
    {
      "key": "productBaseUrl",
      "value": "http://localhost:3002"
    },
    {
      "key": "orderBaseUrl",
      "value": "http://localhost:3003"
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "tempUserId",
      "value": ""
    },
    {
      "key": "invalidId",
      "value": "000000000000000000000000"
    }
  ],
