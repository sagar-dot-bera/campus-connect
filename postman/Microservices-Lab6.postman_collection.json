      "name": "04 Failure & Recovery",
      "item": [
        {
          "name": "Create order - User Service DOWN (503)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{orderBaseUrl}}/orders",
              "host": [
                "{{orderBaseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 1\n}"
            },
            "description": "BEFORE sending: docker compose stop user-service"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 503', () => pm.response.to.have.status(503));",
                  "pm.test('Names the failed dependency', () => pm.expect(pm.response.json().dependency).to.eql('user-service'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create order - after recovery (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
