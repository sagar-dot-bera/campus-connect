            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 2\n}"
            },
            "description": "Order Service calls GET http://user-service:3001/users/{id} and GET http://product-service:3002/products/{id} over campus-network."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('orderId', pm.response.json().id);",
                  "const o = pm.response.json();",
                  "pm.test('User data came from User Service', () => pm.expect(o.userName).to.eql('Ada Lovelace'));",
                  "pm.test('Product data came from Product Service', () => { pm.expect(o.productName).to.eql('Data Structures Textbook'); pm.expect(o.unitPrice).to.eql(40); });",
                  "pm.test('Total computed', () => pm.expect(o.totalPrice).to.eql(80));"
                ]
              }
            }
          ]
        },
