            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 1\n}"
            },
            "description": "BEFORE sending: docker compose start user-service (wait a few seconds)"
          },
          "event": [
