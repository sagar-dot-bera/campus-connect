# ─────────────────────────────────────────────────────────────────────────────
# Secret: MongoDB Atlas URIs
#
# SECURITY NOTICE:
#   This file is a TEMPLATE only. The actual values must be set via:
#     kubectl create secret generic mongodb-secret \
#       --from-literal=USER_MONGODB_URI='mongodb+srv://...' \
#       --from-literal=PRODUCT_MONGODB_URI='mongodb+srv://...' \
#       --from-literal=ORDER_MONGODB_URI='mongodb+srv://...' \
#       -n lab8
#
#   Do NOT commit real credentials. This template file uses placeholder values.
#   The real Secret is created imperatively (see README) and never committed.
# ─────────────────────────────────────────────────────────────────────────────
apiVersion: v1
kind: Secret
metadata:
  name: mongodb-secret
  namespace: lab8
  labels:
    app.kubernetes.io/name: campusconnect
    app.kubernetes.io/component: config
    app.kubernetes.io/part-of: campusconnect
type: Opaque
# Base64-encoded placeholders — replace with real values using kubectl imperative
# command shown above, or set via GitHub Actions secret + CI/CD.
# To encode: echo -n 'your-value' | base64
stringData:
  USER_MONGODB_URI: "REPLACE_WITH_BASE64_ENCODED_URI"
  PRODUCT_MONGODB_URI: "REPLACE_WITH_BASE64_ENCODED_URI"
  ORDER_MONGODB_URI: "REPLACE_WITH_BASE64_ENCODED_URI"
