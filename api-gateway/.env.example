# Used when running the gateway directly with `npm start` (outside Docker)
PORT=8080

# Service registry: where each backend service lives. Change these, not the code.
USER_SERVICE_URL=http://localhost:3001
PRODUCT_SERVICE_URL=http://localhost:3002
ORDER_SERVICE_URL=http://localhost:3003

# How long the gateway waits for a backend before answering 503
GATEWAY_PROXY_TIMEOUT_MS=10000
