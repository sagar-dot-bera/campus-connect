# Copy to .env to override the defaults in compose.yaml.

# The only port published on the host
GATEWAY_PORT=8080

# Internal container ports (not published; reachable only on campus-network)
USER_SERVICE_PORT=3001
PRODUCT_SERVICE_PORT=3002
ORDER_SERVICE_PORT=3003

# ---- Service registry ----
# Read by the API Gateway (all three) and by Order Service (user + product).
# Container-to-container URLs: Compose service names, never localhost.
# Keep the port in each URL in sync with the matching *_SERVICE_PORT.
USER_SERVICE_URL=http://user-service:3001
PRODUCT_SERVICE_URL=http://product-service:3002
ORDER_SERVICE_URL=http://order-service:3003

# How long Order Service waits for a dependency before returning 503
DEPENDENCY_TIMEOUT_MS=3000
# How long the gateway waits for a backend before returning 503
GATEWAY_PROXY_TIMEOUT_MS=10000

# ---- Optional: use MongoDB Atlas instead of the local mongo containers ----
# Leave unset to use user-db / product-db / order-db. These ARE secrets: keep them
# in .env only (git-ignored), never in .env.example.
# USER_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/userdb
# PRODUCT_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/productdb
# ORDER_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/orderdb
